{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "logicAppName": {
      "type": "string",
      "metadata": { "description": "Name for the Logic App resource." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region. Must match your other resources." }
    },
    "sharepointSiteUrl": {
      "type": "string",
      "metadata": { "description": "Full SharePoint site URL, e.g. https://corp.sharepoint.com/sites/HR" }
    },
    "sharepointLibrary": {
      "type": "string",
      "defaultValue": "Shared Documents",
      "metadata": { "description": "Document library to watch. Polls the whole library (all subfolders), not just the top level." }
    },
    "domain": {
      "type": "string",
      "defaultValue": "hr",
      "allowedValues": ["hr", "legal", "it", "ops"],
      "metadata": { "description": "Business domain — maps to the Domain enum in shared/models.py" }
    },
    "ingestionAgentUrl": {
      "type": "string",
      "metadata": { "description": "Base URL of the Ingestion Agent container app, no trailing slash." }
    },
    "logicAppSecret": {
      "type": "securestring",
      "metadata": { "description": "Shared secret for X-Logic-App-Secret header. Must match LOGIC_APP_WEBHOOK_SECRET." }
    }
  },

  "variables": {
    "sharepointConnectionName": "sharepointonline",
    "sharepointConnectionId": "[resourceId('Microsoft.Web/connections', variables('sharepointConnectionName'))]"
  },

  "resources": [

    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sharepointConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "SharePoint Online",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
        }
      }
    },

    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[variables('sharepointConnectionId')]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections":      { "defaultValue": {}, "type": "Object" },
            "sharepointSiteUrl": { "defaultValue": "[parameters('sharepointSiteUrl')]", "type": "String" },
            "sharepointLibrary": { "defaultValue": "[parameters('sharepointLibrary')]", "type": "String" },
            "domain":            { "defaultValue": "[parameters('domain')]",             "type": "String" },
            "ingestionAgentUrl": { "defaultValue": "[parameters('ingestionAgentUrl')]",  "type": "String" },
            "logicAppSecret":    { "defaultValue": "",                                   "type": "SecureString" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": { "frequency": "Minute", "interval": 5 }
            }
          },
          "actions": {
            "Get_items": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" }
                },
                "method": "get",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('sharepointLibrary')))}/items",
                "queries": {
                  "$filter": "Modified ge datetime'@{addMinutes(utcNow(), -7)}'",
                  "$top": 500
                }
              }
            },
            "Filter_to_files_only": {
              "type": "Query",
              "runAfter": { "Get_items": ["Succeeded"] },
              "inputs": {
                "from": "@body('Get_items')?['value']",
                "where": "@not(equals(item()?['{IsFolder}'], true))"
              }
            },
            "For_each_changed_file": {
              "type": "Foreach",
              "runAfter": { "Filter_to_files_only": ["Succeeded"] },
              "foreach": "@body('Filter_to_files_only')",
              "actions": {
                "Get_file_content": {
                  "type": "ApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connection": { "name": "@parameters('$connections')['sharepointonline']['connectionId']" }
                    },
                    "method": "get",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepointSiteUrl')))}/GetFileContentByPath",
                    "queries": { "path": "@{concat('/', item()?['{FullPath}'])}", "inferContentType": false }
                  }
                },
                "Send_to_Ingestion_Agent": {
                  "type": "Http",
                  "runAfter": { "Get_file_content": ["Succeeded"] },
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('ingestionAgentUrl')}/ingest/from-logic-app",
                    "headers": {
                      "Content-Type": "application/json",
                      "X-Logic-App-Secret": "@parameters('logicAppSecret')"
                    },
                    "body": {
                      "doc_name": "@{item()?['{FilenameWithExtension}']}",
                      "doc_url":  "@{item()?['{Link}']}",
                      "domain":   "@parameters('domain')",
                      "file_type": "@{last(split(item()?['{FilenameWithExtension}'], '.'))}",
                      "file_content_base64": "@{base64(body('Get_file_content'))}",
                      "is_delete": false
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S",
                      "minimumInterval": "PT10S",
                      "maximumInterval": "PT1H"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "sharepointonline": {
                "connectionId": "[variables('sharepointConnectionId')]",
                "connectionName": "[variables('sharepointConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
              }
            }
          },
          "logicAppSecret": { "value": "[parameters('logicAppSecret')]" }
        }
      }
    }

  ],

  "outputs": {
    "logicAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    }
  }
}
