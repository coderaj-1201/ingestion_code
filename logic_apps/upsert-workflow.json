{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "sharepointSiteUrl": {
      "defaultValue": "https://<tenant>.sharepoint.com/sites/<site>",
      "type": "String"
    },
    "sharepointLibrary": {
      "defaultValue": "Global Ops Playbook",
      "type": "String"
    },
    "domain": {
      "defaultValue": "hr",
      "type": "String"
    },
    "ingestionAgentUrl": {
      "defaultValue": "https://<ingestion-agent-url>",
      "type": "String"
    },
    "logicAppSecret": {
      "defaultValue": "",
      "type": "SecureString"
    },
    "storageAccountName": {
      "defaultValue": "<storage-account-name>",
      "type": "String"
    }
  },

  "triggers": {
    "Recurrence": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Minute",
        "interval": 5
      }
    }
  },

  "actions": {

    "Initialize_changed_items": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [{"name": "changedItems", "type": "array", "value": []}]
      }
    },

    "Initialize_changed_skip": {
      "type": "InitializeVariable",
      "runAfter": {"Initialize_changed_items": ["Succeeded"]},
      "inputs": {
        "variables": [{"name": "changedSkip", "type": "integer", "value": 0}]
      }
    },

    "Initialize_changed_has_more": {
      "type": "InitializeVariable",
      "runAfter": {"Initialize_changed_skip": ["Succeeded"]},
      "inputs": {
        "variables": [{"name": "changedHasMore", "type": "boolean", "value": true}]
      }
    },

    "Compose_cutoff_time": {
      "type": "Compose",
      "runAfter": {"Initialize_changed_has_more": ["Succeeded"]},
      "inputs": "@addMinutes(utcNow(), -6)"
    },

    "Paginate_changed_documents": {
      "type": "Until",
      "runAfter": {"Compose_cutoff_time": ["Succeeded"]},
      "expression": "@equals(variables('changedHasMore'), false)",
      "limit": {"count": 20, "timeout": "PT10M"},
      "actions": {
        "Get_changed_page": {
          "type": "ApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('sharepointLibrary')))}/items",
            "queries": {
              "$filter": "Modified ge datetime'@{outputs('Compose_cutoff_time')}'",
              "$orderby": "ID asc",
              "$top": 500,
              "$skip": "@variables('changedSkip')"
            }
          }
        },
        "Compose_merged_changed_items": {
          "type": "Compose",
          "runAfter": {"Get_changed_page": ["Succeeded"]},
          "inputs": "@union(variables('changedItems'), body('Get_changed_page')?['value'])"
        },
        "Append_page_to_changed_items": {
          "type": "SetVariable",
          "runAfter": {"Compose_merged_changed_items": ["Succeeded"]},
          "inputs": {
            "name": "changedItems",
            "value": "@outputs('Compose_merged_changed_items')"
          }
        },
        "Compose_new_changed_skip": {
          "type": "Compose",
          "runAfter": {"Append_page_to_changed_items": ["Succeeded"]},
          "inputs": "@add(variables('changedSkip'), 500)"
        },
        "Increment_changed_skip": {
          "type": "SetVariable",
          "runAfter": {"Compose_new_changed_skip": ["Succeeded"]},
          "inputs": {
            "name": "changedSkip",
            "value": "@outputs('Compose_new_changed_skip')"
          }
        },
        "Set_changed_has_more": {
          "type": "SetVariable",
          "runAfter": {"Increment_changed_skip": ["Succeeded"]},
          "inputs": {
            "name": "changedHasMore",
            "value": "@greater(length(body('Get_changed_page')?['value']), 499)"
          }
        }
      }
    },

    "Filter_to_files_only": {
      "type": "Query",
      "runAfter": {
        "Paginate_changed_documents": ["Succeeded"]
      },
      "inputs": {
        "from": "@variables('changedItems')",
        "where": "@not(equals(item()?['{IsFolder}'], true))"
      }
    },

    "For_each_changed_file": {
      "type": "Foreach",
      "runAfter": {
        "Filter_to_files_only": ["Succeeded"]
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 10
        }
      },
      "foreach": "@body('Filter_to_files_only')",
      "actions": {

        "Get_file_content": {
          "type": "ApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepointSiteUrl')))}/GetFileContentByPath",
            "queries": {
              "path": "@{concat('/', item()?['{FullPath}'])}",
              "inferContentType": false
            }
          }
        },

        "Send_to_Ingestion_Agent": {
          "type": "Http",
          "runAfter": {
            "Get_file_content": ["Succeeded"]
          },
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('ingestionAgentUrl')}/ingest/from-logic-app",
            "headers": {
              "Content-Type": "application/json",
              "X-Logic-App-Secret": "@parameters('logicAppSecret')"
            },
            "body": {
              "doc_name": "@{item()?['{FilenameWithExtension}']}",
              "doc_path": "@{item()?['{FullPath}']}",
              "doc_url": "@{item()?['{Link}']}",
              "domain": "@parameters('domain')",
              "file_type": "@{last(split(item()?['{FilenameWithExtension}'], '.'))}",
              "file_content_base64": "@{base64(body('Get_file_content'))}",
              "is_delete": false
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S",
              "minimumInterval": "PT10S",
              "maximumInterval": "PT1H"
            }
          }
        }

      }
    },

    "Initialize_doc_items": {
      "type": "InitializeVariable",
      "runAfter": {
        "For_each_changed_file": ["Succeeded", "Skipped", "Failed"]
      },
      "inputs": {
        "variables": [{"name": "docItems", "type": "array", "value": []}]
      }
    },

    "Initialize_skip_count": {
      "type": "InitializeVariable",
      "runAfter": {"Initialize_doc_items": ["Succeeded"]},
      "inputs": {
        "variables": [{"name": "skipCount", "type": "integer", "value": 0}]
      }
    },

    "Initialize_has_more": {
      "type": "InitializeVariable",
      "runAfter": {"Initialize_skip_count": ["Succeeded"]},
      "inputs": {
        "variables": [{"name": "hasMore", "type": "boolean", "value": true}]
      }
    },

    "Paginate_all_documents": {
      "type": "Until",
      "runAfter": {"Initialize_has_more": ["Succeeded"]},
      "expression": "@equals(variables('hasMore'), false)",
      "limit": {"count": 20, "timeout": "PT15M"},
      "actions": {
        "Get_document_page": {
          "type": "ApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('sharepointLibrary')))}/items",
            "queries": {
              "$filter": "FSObjType eq 0",
              "$orderby": "ID asc",
              "$top": 500,
              "$skip": "@variables('skipCount')"
            }
          }
        },
        "Compose_merged_doc_items": {
          "type": "Compose",
          "runAfter": {"Get_document_page": ["Succeeded"]},
          "inputs": "@union(variables('docItems'), body('Get_document_page')?['value'])"
        },
        "Append_page_to_doc_items": {
          "type": "SetVariable",
          "runAfter": {"Compose_merged_doc_items": ["Succeeded"]},
          "inputs": {
            "name": "docItems",
            "value": "@outputs('Compose_merged_doc_items')"
          }
        },
        "Compose_new_skip_count": {
          "type": "Compose",
          "runAfter": {"Append_page_to_doc_items": ["Succeeded"]},
          "inputs": "@add(variables('skipCount'), 500)"
        },
        "Increment_skip_count": {
          "type": "SetVariable",
          "runAfter": {"Compose_new_skip_count": ["Succeeded"]},
          "inputs": {
            "name": "skipCount",
            "value": "@outputs('Compose_new_skip_count')"
          }
        },
        "Set_has_more": {
          "type": "SetVariable",
          "runAfter": {"Increment_skip_count": ["Succeeded"]},
          "inputs": {
            "name": "hasMore",
            "value": "@greater(length(body('Get_document_page')?['value']), 499)"
          }
        }
      }
    },

    "Filter_to_documents_only": {
      "type": "Query",
      "runAfter": {
        "Paginate_all_documents": ["Succeeded"]
      },
      "inputs": {
        "from": "@variables('docItems')",
        "where": "@or(endswith(item()?['{FilenameWithExtension}'], '.pdf'), endswith(item()?['{FilenameWithExtension}'], '.docx'), endswith(item()?['{FilenameWithExtension}'], '.xlsx'), endswith(item()?['{FilenameWithExtension}'], '.pptx'), endswith(item()?['{FilenameWithExtension}'], '.png'), endswith(item()?['{FilenameWithExtension}'], '.jpg'), endswith(item()?['{FilenameWithExtension}'], '.jpeg'), endswith(item()?['{FilenameWithExtension}'], '.gif'), endswith(item()?['{FilenameWithExtension}'], '.webp'), endswith(item()?['{FilenameWithExtension}'], '.bmp'), endswith(item()?['{FilenameWithExtension}'], '.tiff'), endswith(item()?['{FilenameWithExtension}'], '.tif'), endswith(item()?['{FilenameWithExtension}'], '.mp4'), endswith(item()?['{FilenameWithExtension}'], '.mov'), endswith(item()?['{FilenameWithExtension}'], '.avi'), endswith(item()?['{FilenameWithExtension}'], '.mkv'), endswith(item()?['{FilenameWithExtension}'], '.wmv'), endswith(item()?['{FilenameWithExtension}'], '.flv'), endswith(item()?['{FilenameWithExtension}'], '.mxf'))"
      }
    },

    "Build_current_names": {
      "type": "Select",
      "runAfter": {
        "Filter_to_documents_only": ["Succeeded"]
      },
      "inputs": {
        "from": "@body('Filter_to_documents_only')",
        "select": "@item()?['{FullPath}']"
      }
    },

    "Read_snapshot": {
      "type": "Http",
      "runAfter": {
        "Build_current_names": ["Succeeded"]
      },
      "inputs": {
        "method": "GET",
        "uri": "https://@{parameters('storageAccountName')}.blob.core.windows.net/processed-chunks/snapshots/@{parameters('domain')}.json",
        "headers": {
          "x-ms-version": "2020-04-08"
        },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://storage.azure.com/"
        }
      }
    },

    "Parse_snapshot": {
      "type": "ParseJson",
      "runAfter": {
        "Read_snapshot": ["Succeeded", "Failed"]
      },
      "inputs": {
        "content": "@if(equals(outputs('Read_snapshot')['statusCode'], 200), body('Read_snapshot'), json('[]'))",
        "schema": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "Check_snapshot_safety": {
      "type": "If",
      "runAfter": {
        "Parse_snapshot": ["Succeeded"]
      },
      "expression": {
        "or": [
          {
            "and": [
              {
                "equals": ["@length(body('Parse_snapshot'))", 0]
              },
              {
                "greater": ["@length(body('Build_current_names'))", 0]
              }
            ]
          },
          {
            "greaterOrEquals": [
              "@mul(length(body('Build_current_names')), 10)",
              "@mul(length(body('Parse_snapshot')), 8)"
            ]
          }
        ]
      },
      "actions": {

        "Find_deleted_files": {
          "type": "Query",
          "runAfter": {},
          "inputs": {
            "from": "@body('Parse_snapshot')",
            "where": "@not(contains(body('Build_current_names'), item()))"
          }
        },

        "For_each_deleted_file": {
          "type": "Foreach",
          "runAfter": {
            "Find_deleted_files": ["Succeeded"]
          },
          "foreach": "@body('Find_deleted_files')",
          "actions": {
            "Send_delete_to_Ingestion_Agent": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('ingestionAgentUrl')}/ingest/from-logic-app",
                "headers": {
                  "Content-Type": "application/json",
                  "X-Logic-App-Secret": "@parameters('logicAppSecret')"
                },
                "body": {
                  "doc_name": "@{last(split(item(), '/'))}",
                  "doc_path": "@{item()}",
                  "doc_url": "",
                  "domain": "@parameters('domain')",
                  "file_type": "@{last(split(item(), '.'))}",
                  "file_content_base64": "",
                  "is_delete": true
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S",
                  "minimumInterval": "PT10S",
                  "maximumInterval": "PT1H"
                }
              }
            }
          }
        },

        "Save_snapshot": {
          "type": "Http",
          "runAfter": {
            "For_each_deleted_file": ["Succeeded", "Skipped"]
          },
          "inputs": {
            "method": "PUT",
            "uri": "https://@{parameters('storageAccountName')}.blob.core.windows.net/processed-chunks/snapshots/@{parameters('domain')}.json",
            "headers": {
              "x-ms-version": "2020-04-08",
              "x-ms-blob-type": "BlockBlob",
              "Content-Type": "application/json"
            },
            "body": "@body('Build_current_names')",
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://storage.azure.com/"
            }
          }
        }

      },

      "else": {
        "actions": {
          "Abort_unsafe_snapshot": {
            "type": "Terminate",
            "runAfter": {},
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "SnapshotSafetyAbort",
                "message": "Aborting delete run: current file count (@{length(body('Build_current_names'))}) is less than 80% of snapshot count (@{length(body('Parse_snapshot'))}). SharePoint may have returned a truncated result. Snapshot NOT updated."
              }
            }
          }
        }
      }
    }

  }
}
