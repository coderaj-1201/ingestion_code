{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "sharepointSiteUrl": {
      "defaultValue": "https://<tenant>.sharepoint.com/sites/<site>",
      "type": "String"
    },
    "sharepointLibrary": {
      "defaultValue": "Global Ops Playbook",
      "type": "String"
    },
    "domain": {
      "defaultValue": "hr",
      "type": "String"
    },
    "ingestionAgentUrl": {
      "defaultValue": "https://<ingestion-agent-url>",
      "type": "String"
    },
    "logicAppSecret": {
      "defaultValue": "",
      "type": "SecureString"
    }
  },

  "triggers": {
    "Recurrence": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Minute",
        "interval": 5
      }
    }
  },

  "actions": {

    "Get_items": {
      "type": "ApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
          }
        },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('sharepointLibrary')))}/items",
        "queries": {
          "$filter": "Modified ge datetime'@{addMinutes(utcNow(), -7)}'",
          "$select": "ID,FileLeafRef,FileRef,Modified,FSObjType",
          "$top": 500
        }
      }
    },

    "Filter_to_files_only": {
      "type": "Query",
      "runAfter": {
        "Get_items": ["Succeeded"]
      },
      "inputs": {
        "from": "@body('Get_items')?['value']",
        "where": "@not(equals(string(item()?['FSObjType']), '1'))"
      }
    },

    "For_each_changed_file": {
      "type": "Foreach",
      "runAfter": {
        "Filter_to_files_only": ["Succeeded"]
      },
      "foreach": "@body('Filter_to_files_only')",
      "actions": {

        "Get_file_content": {
          "type": "ApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepointSiteUrl')))}/files/@{encodeURIComponent(item()?['ID'])}/content",
            "queries": {
              "inferContentType": false
            }
          }
        },

        "Send_to_Ingestion_Agent": {
          "type": "Http",
          "runAfter": {
            "Get_file_content": ["Succeeded"]
          },
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('ingestionAgentUrl')}/ingest/from-logic-app",
            "headers": {
              "Content-Type": "application/json",
              "X-Logic-App-Secret": "@parameters('logicAppSecret')"
            },
            "body": {
              "doc_name": "@{item()?['FileLeafRef']}",
              "doc_url": "@{item()?['FileRef']}",
              "domain": "@parameters('domain')",
              "file_type": "@{last(split(item()?['FileLeafRef'], '.'))}",
              "file_content_base64": "@{base64(body('Get_file_content'))}",
              "is_delete": false
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S",
              "minimumInterval": "PT10S",
              "maximumInterval": "PT1H"
            }
          }
        }

      }
    }

  }
}
